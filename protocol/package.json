{
  "name": "@probecli/cli",
  "version": "0.5.0",
  "license": "MIT",
  "description": "probe: run reproducible tests for Uniswap v4 hooks, get paid for verified work, and check any deployed hook.",
  "keywords": [
    "uniswap",
    "uniswap-v4",
    "hooks",
    "foundry",
    "solidity",
    "security",
    "testing",
    "robinhood-chain",
    "cli"
  ],
  "homepage": "https://probecli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probecli/probe.git",
    "directory": "protocol"
  },
  "bugs": {
    "url": "https://github.com/probecli/probe/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "probe": "bin/probe.mjs"
  },
  "files": [
    "bin/probe.mjs",
    "dist/probe.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verifier": "node src/verifier/server.ts",
    "probe": "node bin/probe.mjs",
    "abi": "node scripts/gen-abi.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit.test.ts test/hookcheck.test.ts test/verify.test.ts",
    "e2e": "node scripts/e2e.ts",
    "preflight": "node scripts/preflight.ts",
    "dev:stack": "node scripts/dev-stack.ts",
    "build": "node scripts/build-cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.10",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
