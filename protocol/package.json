{
  "name": "probe-protocol",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "PROBE verifier service and probe CLI",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "probe": "./bin/probe.mjs"
  },
